<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CreatorPay.Domain\CreatorPay.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UGC contract templates: legal text lives in files, not code -->
    <!-- WithCulture=false: the ".sv" in "contract.sv.md" is a language tag, not a satellite culture -->
    <EmbeddedResource Include="Ugc\Contracts\*.md" WithCulture="false" LogicalName="CreatorPay.Application.Ugc.Contracts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

